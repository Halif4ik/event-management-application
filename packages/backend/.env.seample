#docker or local
DB_HOST=localhost:5433
DB_HOST_DOC=postgredb:5432
#nest ports
PORT=3030
NODE_OUTSIZE_FOR_DOCKER_PORT=3009
CORS_HOST_HTTP=http://localhost
SWAGGER_HOST=docs
POSTGRES_DOCKER_PORT=5432
POSTGRES_LOCAL_PORT=5433
POSTGRES_USER=postgres
POSTGRES_ROOT_PASSWORD=admin
POSTGRES_DATABASE=event_manag

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_ROOT_PASSWORD}@${DB_HOST_DOC}/${POSTGRES_DATABASE}?schema=public"
#jwt
SECRET_ACCESS=Temp_ACCESS
EXPIRE_ACCESS=3h
SECRET_REFRESH=Temp_REFRESH
EXPIRE_REFRESH=12h