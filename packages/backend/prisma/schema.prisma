generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  fullName String
  password String
  deleteAt DateTime?
  Auth     Auth?
  // Зв'язок: Один користувач -> багато організованих подій 
  organizedEvents  Event[]       @relation("EventOrganizer")
  // Зв'язок: Багато-до-багатьох для учасників через проміжну модель 
  participations   Participant[]
}

model Auth {
  id        Int      @id @default(autoincrement())
  logined   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String   @unique
}

model Event {
  id           String    @id @default(uuid())
  title        String    // Назва події 
  description  String    @db.Text // Опис події 
  dateTime     DateTime  // Дата та час 
  location     String    // Місце проведення 
  capacity     Int?      // Опціонально: якщо null -> unlimited
  isPublic     Boolean   @default(true) // Публічна чи приватна 
  // Організатор події
  organizerId  String
  organizer    User      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  // Список учасників 
  participants Participant[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Participant {
  id        String   @id @default(uuid())

  // Зв'язок з користувачем
  userId    String  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Зв'язок з подією
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  
  // Забезпечує, що користувач не може приєднатися до однієї події двічі
  @@unique([userId, eventId])
}